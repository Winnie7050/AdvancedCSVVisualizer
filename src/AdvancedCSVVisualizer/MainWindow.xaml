<Window x:Class="AdvancedCSVVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdvancedCSVVisualizer"
        xmlns:views="clr-namespace:AdvancedCSVVisualizer.Views"
        xmlns:viewModels="clr-namespace:AdvancedCSVVisualizer.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        mc:Ignorable="d"
        Title="Advanced CSV Visualizer" 
        Height="800" 
        Width="1200"
        MinHeight="600" 
        MinWidth="900"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Bar -->
        <materialDesign:ColorZone Grid.Row="0" 
                                  Mode="PrimaryDark" 
                                  Padding="16" 
                                  materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartLine" Width="32" Height="32" VerticalAlignment="Center" />
                    <TextBlock Text="Advanced CSV Visualizer" 
                               Style="{StaticResource TitleLargeTextStyle}" 
                               VerticalAlignment="Center" 
                               Margin="16,0,0,0" />
                </StackPanel>

                <!-- Main Navigation -->
                <StackPanel Grid.Column="1" 
                          Orientation="Horizontal" 
                          HorizontalAlignment="Center">
                    <RadioButton Content="Dashboard" 
                                 IsChecked="{Binding IsDashboardSelected}"
                                 Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Margin="4" 
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="Dashboard"/>
                    <RadioButton Content="Line Chart" 
                                 IsChecked="{Binding IsLineChartSelected}"
                                 Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Margin="4" 
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="LineChart"/>
                    <RadioButton Content="Bar Chart" 
                                 IsChecked="{Binding IsBarChartSelected}"
                                 Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Margin="4" 
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="BarChart"/>
                    <RadioButton Content="Pie Chart" 
                                 IsChecked="{Binding IsPieChartSelected}"
                                 Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Margin="4" 
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="PieChart"/>
                    <RadioButton Content="Diverging Chart" 
                                 IsChecked="{Binding IsDivergingBarSelected}"
                                 Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 Margin="4" 
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="DivergingBar"/>
                </StackPanel>

                <!-- Settings Button -->
                <Button Grid.Column="2" 
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Settings"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Settings">
                    <materialDesign:PackIcon Kind="Settings" Width="24" Height="24" />
                </Button>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="16">
            <ContentControl Content="{Binding CurrentView}" />
        </Grid>

        <!-- Status Bar -->
        <materialDesign:ColorZone Grid.Row="2" 
                                  Mode="PrimaryDark" 
                                  Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           Style="{StaticResource BodySmallTextStyle}" 
                           VerticalAlignment="Center" 
                           Margin="8,0" />

                <!-- Version Info -->
                <TextBlock Grid.Column="1" 
                           Text="{Binding VersionInfo}" 
                           Style="{StaticResource BodySmallTextStyle}" 
                           VerticalAlignment="Center" 
                           Margin="8,0" />
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</Window>
