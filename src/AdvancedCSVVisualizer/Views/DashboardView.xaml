<UserControl x:Class="AdvancedCSVVisualizer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdvancedCSVVisualizer.Views"
             xmlns:vm="clr-namespace:AdvancedCSVVisualizer.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- Title -->
            <TextBlock Text="Dashboard" 
                       Style="{StaticResource HeadlineMediumTextStyle}" 
                       Grid.Column="0"
                       VerticalAlignment="Center" />
            
            <!-- Refresh Button -->
            <Button Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Refresh Files"
                    Command="{Binding RefreshFileListCommand}">
                <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24" />
            </Button>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            
            <!-- File Browser Panel -->
            <Border Grid.Column="0" 
                    Style="{StaticResource ChartContainerStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- File Browser Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Section Title -->
                        <TextBlock Text="File Browser" 
                                   Style="{StaticResource TitleMediumTextStyle}" 
                                   Grid.Column="0"
                                   VerticalAlignment="Center" />
                        
                        <!-- Up Directory Button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Go to Parent Directory"
                                Command="{Binding NavigateToParentDirectoryCommand}">
                            <materialDesign:PackIcon Kind="ArrowUpBold" Width="20" Height="20" />
                        </Button>
                    </Grid>
                    
                    <!-- Directory Selection -->
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding AvailableDirectories}"
                              SelectedItem="{Binding SelectedDirectory}"
                              IsEditable="True"
                              materialDesign:HintAssist.Hint="Select Directory"
                              Style="{StaticResource MaterialDesignFilledComboBox}"
                              Margin="0,0,0,16"
                              HorizontalAlignment="Stretch" />
                    
                    <!-- File List -->
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding AvailableFiles}"
                              SelectedItem="{Binding SelectedFile}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="250">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileOutline" 
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} KB">
                                                        <Binding Path="Length" Converter="{StaticResource SizeToKbConverter}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Modified" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
            
            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="{StaticResource SurfaceBrush}" />
            
            <!-- File Preview and Actions Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- File Preview -->
                <Border Grid.Row="0" 
                        Style="{StaticResource ChartContainerStyle}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- Preview Header -->
                        <TextBlock Text="File Preview" 
                                   Style="{StaticResource TitleMediumTextStyle}" 
                                   Grid.Row="0"
                                   Margin="0,0,0,16" />
                        
                        <!-- File Metadata -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,16" Visibility="{Binding IsFileSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="File Information" Style="{StaticResource LabelLargeTextStyle}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Metric:" Style="{StaticResource LabelMediumTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding FileMetadata.MetricName}" Style="{StaticResource BodyMediumTextStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Identifier:" Style="{StaticResource LabelMediumTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding FileMetadata.Identifier}" Style="{StaticResource BodyMediumTextStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date Range:" Style="{StaticResource LabelMediumTextStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileMetadata.StartDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource BodyMediumTextStyle}" />
                                    <TextBlock Text=" to " Style="{StaticResource BodyMediumTextStyle}" />
                                    <TextBlock Text="{Binding FileMetadata.EndDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource BodyMediumTextStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Row Count:" Style="{StaticResource LabelMediumTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding FileMetadata.RowCount}" Style="{StaticResource BodyMediumTextStyle}" />
                            </Grid>
                        </StackPanel>
                        
                        <!-- Preview Content -->
                        <Border Grid.Row="2" 
                                Background="{StaticResource BackgroundBrush}" 
                                BorderBrush="{StaticResource SurfaceLightBrush}"
                                BorderThickness="1"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding FilePreview}" 
                                           FontFamily="Consolas"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- Actions Panel -->
                <Border Grid.Row="1" 
                        Style="{StaticResource ChartContainerStyle}"
                        Margin="8,8,8,0"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Actions Header -->
                        <TextBlock Text="Load as Visualization" 
                                   Style="{StaticResource TitleMediumTextStyle}" 
                                   Grid.Row="0"
                                   Margin="0,0,0,16" />
                        
                        <!-- Actions Buttons -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Line Chart" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoadAsLineChartCommand}"
                                    Margin="8,0">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ChartLine" Margin="0,0,8,0" />
                                            <TextBlock Text="Line Chart" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            
                            <Button Content="Bar Chart" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoadAsBarChartCommand}"
                                    Margin="8,0">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ChartBar" Margin="0,0,8,0" />
                                            <TextBlock Text="Bar Chart" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            
                            <Button Content="Pie Chart" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoadAsPieChartCommand}"
                                    Margin="8,0">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ChartPie" Margin="0,0,8,0" />
                                            <TextBlock Text="Pie Chart" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            
                            <Button Content="Diverging Bar" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoadAsDivergingBarChartCommand}"
                                    Margin="8,0">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ChartBarStacked" Margin="0,0,8,0" />
                                            <TextBlock Text="Diverging Bar" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Busy Indicator -->
        <Grid Grid.Row="0" Grid.RowSpan="2" 
              Background="#80000000" 
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="300" 
                             Height="8"
                             Margin="0,0,0,16" />
                <TextBlock Text="{Binding BusyMessage}" 
                           Style="{StaticResource BodyLargeTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        
        <!-- Error Message -->
        <materialDesign:Snackbar Grid.Row="0" Grid.RowSpan="2"
                                 IsActive="{Binding HasError}"
                                 Message="{Binding ErrorMessage}">
            <materialDesign:Snackbar.ActionContent>
                <Button Content="DISMISS"
                        Command="{Binding ClearErrorCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{StaticResource PrimaryLightBrush}" />
            </materialDesign:Snackbar.ActionContent>
        </materialDesign:Snackbar>
    </Grid>
</UserControl>
